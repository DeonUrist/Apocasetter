<Project Sdk="Microsoft.NET.Sdk">
  <!-- BepInEx preloader patcher that applies the Mods window's staged updates / removals at start-up. -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>Apocasetter.Installer</AssemblyName>
    <RootNamespace>Apocasetter.Installer</RootNamespace>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GameDir Condition="'$(GameDir)' == ''">E:\SteamLibrary\steamapps\common\Apocalypter</GameDir>
    <ManagedDir>$(GameDir)\Apocalypter_Data\Managed</ManagedDir>
    <BepInExCore>$(GameDir)\BepInEx\core</BepInExCore>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\MiniJson.cs" />
    <Reference Include="BepInEx"><HintPath>$(BepInExCore)\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Mono.Cecil"><HintPath>$(BepInExCore)\Mono.Cecil.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="System.IO.Compression"><HintPath>$(ManagedDir)\System.IO.Compression.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="DeployToGame" AfterTargets="Build">
    <Copy SourceFiles="$(OutDir)$(AssemblyName).dll" DestinationFolder="$(GameDir)\BepInEx\patchers" />
  </Target>
</Project>
